FROM python:3.11-slim

# Create non-root runner user with UID 10001 and set up directories
RUN useradd -u 10001 -m -s /bin/sh runner && \
    mkdir -p /runner /work/repo /work/out /tmp && \
    chown -R 10001:10001 /runner /work /tmp

WORKDIR /work

COPY sandbox/runner.py /runner/runner.py

USER 10001:10001

ENTRYPOINT ["python", "/runner/runner.py"]
